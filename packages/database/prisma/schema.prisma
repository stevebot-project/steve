generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Feedback {
  id        Int      @id @default(autoincrement())
  content   String
  timestamp DateTime

  @@map("feedback")
}

model Guild {
  id                        String    @id @db.VarChar(19)
  channelMemberlog          String?   @map("channels.memberlog") @db.VarChar(19)
  channelServerlog          String?   @map("channels.serverlog") @db.VarChar(19)
  deletePinMessages         Boolean   @default(false)
  logEventChannelCreate     Boolean   @default(true) @map("logEvents.channelCreate")
  logEventChannelDelete     Boolean   @default(true) @map("logEvents.channelDelete")
  logEventChannelUpdate     Boolean   @default(true) @map("logEvents.channelUpdate")
  logEventEmojiCreate       Boolean   @default(true) @map("logEvents.emojiCreate")
  logEventEmojiDelete       Boolean   @default(true) @map("logEvents.emojiDelete")
  logEventEmojiUpdate       Boolean   @default(true) @map("logEvents.emojiUpdate")
  logEventGuildBanAdd       Boolean   @default(true) @map("logEvents.guildBanAdd")
  logEventGuildBanRemove    Boolean   @default(true) @map("logEvents.guildBanRemove")
  logEventGuildMemberAdd    Boolean   @default(true) @map("logEvents.guildMemberAdd")
  logEventGuildMemberRemove Boolean   @default(true) @map("logEvents.guildMemberRemove")
  logEventGuildMemberUpdate Boolean   @default(true) @map("logEvents.guildMemberUpdate")
  logEventInviteCreate      Boolean   @default(true) @map("logEvents.inviteCreate")
  logEventInviteDelete      Boolean   @default(true) @map("logEvents.inviteDelete")
  logEventMessageDelete     Boolean   @default(true) @map("logEvents.messageDelete")
  logEventMessageDeleteBulk Boolean   @default(true) @map("logEvents.messageDeleteBulk")
  logEventRoleCreate        Boolean   @default(true) @map("logEvents.roleCreate")
  logEventRoleDelete        Boolean   @default(true) @map("logEvents.roleDelete")
  logEventRoleUpdate        Boolean   @default(true) @map("logEvents.roleUpdate")
  roleAdministrator         String?   @map("roles.administrator") @db.VarChar(19)
  roleAssignable            String[]  @default([]) @map("roles.assignable") @db.VarChar(19)
  roleModerator             String?   @map("roles.moderator") @db.VarChar(19)
  snippets                  Snippet[]

  @@map("guilds")
}

model Snippet {
  content String  @db.VarChar(1900)
  embed   Boolean @default(false)
  guild   Guild   @relation(fields: [guildId], references: [id])
  guildId String  @db.VarChar(19)
  name    String  @db.VarChar(100)

  @@id(name: "snippetId", [guildId, name])
  @@map("snippets")
}

model User {
  id         String  @id @db.VarChar(19)
  embedColor String? @db.VarChar(6)

  @@map("users")
}
